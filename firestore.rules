rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default catch-all security posture: absolutely deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper utilities
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Safe schema assertions for user structures:
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) 
        && data.uid == request.auth.uid 
        && data.email is string 
        && data.email.size() <= 256;
    }

    // Rules matching individual user document pathways
    match /users/{userId} {
      // Users can only access/modify their own grocery data and setting indexes
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && (
        // Allow updating custom fields like loyalty card configs or grocery comparison basket listings
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['loyaltyCards', 'region', 'basket', 'updatedAt', 'name'])
      );
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
