# ==============================================================================
# CHUSE - ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Client (Required for client-side Auth & Database)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Server / Admin (Optional: for elevated backend persistence)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API Key (Optional: for AI Savings Wizard South African budget assistant)
GEMINI_API_KEY=your-gemini-api-key-here

# Server Port
PORT=3000
